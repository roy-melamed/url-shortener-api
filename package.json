{
  "name": "url-shortener-api",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first URL shortener API (API + database only) — serverless on AWS Lambda + API Gateway HTTP API, PostgreSQL on AWS RDS. See PRD.md and specs/url-shortener-api/.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:log-shape": "vitest run tests/integration/observability-http.test.ts tests/unit/logger.test.ts",
    "probe:readiness": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/probe-readiness.ts",
    "check:naming": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-naming-policy.ts",
    "check:watcher-offline": "python3 -B tools/jira-evidence-watcher/check_offline.py",
    "test:watcher-offline": "PYTHONPATH=tools/jira-evidence-watcher/src python3 -B -m unittest discover -s tests/jira-evidence-watcher -v",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language ts",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --migration-file-language ts",
    "cdk:synth": "cdk synth --quiet",
    "job:maintenance": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/run-maintenance-job.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/id-generator-aws-xray": "3.0.1",
    "@opentelemetry/instrumentation-aws-sdk": "0.80.0",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "aws-cdk-lib": "2.275.0",
    "aws-lambda-fastify": "2.2.0",
    "constructs": "10.8.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "node-pg-migrate": "9.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "aws-cdk": "2.1146.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
