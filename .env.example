# Environment contract — URL Shortener API (URL-18)
#
# Copy to `.env` (gitignored) for local development:
#   cp .env.example .env
#
# RULE (design §6.2, §9.4): endpoints and secrets are environment-specific and
# NEVER hardcoded. Cloud values are injected at deploy time (Secrets Manager /
# CDK outputs); local values come from your gitignored `.env`. Every value
# below is a placeholder — no real endpoints, credentials, or secrets are
# committed.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# ── Database (FR-9.3 / NFR-7: local PostgreSQL for development) ──────────────
# Local: docker-compose Postgres (compose stack lands with URL-7; these
# credentials are placeholders that URL-7's compose stack must match or update).
# Deployed: existing Multi-AZ PostgreSQL on AWS RDS behind RDS Proxy (FR-9.2).
DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener
# design §9.4: tiny per-container pool (RDS Proxy multiplexes in the cloud).
DB_POOL_MAX=2
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000
DB_SSL_MODE=disable

# ── Deployed data path (placeholders; injected at deploy time — never commit real values) ──
RDS_PROXY_ENDPOINT=
SECRET_ARN_DB=
SECRET_ARN_JWT=
SECRET_ARN_OAUTH=
SECRET_ARN_CAPTCHA=

# ── Redirect status ─────────────────────────────────────────────────────────
# default 302 — fixed by AD-1/AC-FR-4.1; changing it requires a new human
# decision. Config validation BLOCKS any non-302 value unless
# REDIRECT_STATUS_ALLOW_NON_DEFAULT=true is set alongside a recorded human
# decision (it then warns loudly at startup).
REDIRECT_STATUS=302
REDIRECT_STATUS_ALLOW_NON_DEFAULT=false

# ── Observability (FR-10) ────────────────────────────────────────────────────
# Local: dockerized Jaeger OTLP endpoint (URL-7 compose); deployed: ADOT →
# CloudWatch Metrics + X-Ray.
OTLP_ENDPOINT=http://localhost:4318

# ── GeoIP (AD-2 Option B, design §3.2/§3.9) ─────────────────────────────────
# Local path to the transient GeoIP database file (in-process, IP never leaves
# memory). Vendor/license is an open decision (design §10.9) — placeholder only.
GEO_DB_PATH=./data/geo/geo.db

# ── Email (FR-1.2, design §3.8: double opt-in verification) ──────────────────
# Local: MailHog SMTP (URL-7 compose); deployed: AWS SES.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ── CAPTCHA (FR-2.7; AD-3: trigger mode 'suspicious') ────────────────────────
# The concrete provider vendor is still an open human decision (design §10.8).
CAPTCHA_MODE=suspicious

# ── OAuth clients (FR-1.1; AD-14: Google + GitHub exclusively) ───────────────
# Deployed values come from Secrets Manager — never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
